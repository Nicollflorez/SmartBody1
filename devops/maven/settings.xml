<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuracion de Maven que usa el pipeline para publicar en GitHub Packages.
  Las credenciales NUNCA se escriben aqui: llegan por variables de entorno que Jenkins
  inyecta desde la credencial 'github-packages' (withCredentials).

  Uso manual:  set GITHUB_ACTOR=usuario & set GITHUB_TOKEN=ghp_xxx & mvnw.cmd -s ../devops/maven/settings.xml deploy
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
    <servers>
        <server>
            <id>github</id>
            <username>${env.GITHUB_ACTOR}</username>
            <password>${env.GITHUB_TOKEN}</password>
        </server>
    </servers>
</settings>
