<?xml version="1.0" encoding="UTF-8"?>
<!--
  Solo sirve para descargar Weka 3.8.6 y TODAS sus dependencias transitivas a mineria/lib:
    ..\services\mvnw.cmd -f mineria\pom.xml dependency:copy-dependencies -DoutputDirectory=lib
  Las herramientas de mineria/herramientas se compilan y ejecutan con "java", no con Maven.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.smartbody</groupId>
    <artifactId>smartbody-mineria</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>smartbody-mineria</name>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>nz.ac.waikato.cms.weka</groupId>
            <artifactId>weka-stable</artifactId>
            <version>3.8.6</version>
        </dependency>
    </dependencies>
</project>
