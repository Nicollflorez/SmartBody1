<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.4</version>
        <relativePath/>
    </parent>

    <groupId>com.smartbody</groupId>
    <artifactId>smartbody-backend</artifactId>
    <!-- Version de desarrollo. El pipeline (.gitlab-ci.yml / Jenkinsfile) quita el -SNAPSHOT al publicar un release. -->
    <version>1.0.0-SNAPSHOT</version>
    <name>smartbody-backend</name>
    <description>API REST de Smartbody</description>

    <properties>
        <java.version>17</java.version>
        <jjwt.version>0.12.5</jjwt.version>
        <!-- Repositorio de artefactos (GitHub Packages). Jenkins los sobreescribe con -Dgithub.owner / -Dgithub.repo. -->
        <github.owner>Nicollflorez</github.owner>
        <github.repo>SmartBody1</github.repo>
    </properties>

    <!-- Destino de "mvn deploy": el repositorio Maven de GitHub Packages del proyecto.
         Las credenciales viven en devops/maven/settings.xml (server id "github"), nunca aqui. -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>Smartbody - GitHub Packages</name>
            <url>https://maven.pkg.github.com/${github.owner}/${github.repo}</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <name>Smartbody - GitHub Packages (snapshots)</name>
            <url>https://maven.pkg.github.com/${github.owner}/${github.repo}</url>
        </snapshotRepository>
    </distributionManagement>

    <profiles>
        <!-- Perfil para publicar en el Package Registry de GitLab (repositorio de artefactos de la Etapa 5):
             mvnw -Pgitlab -Dgitlab.maven.url=https://gitlab.com/api/v4/projects/<ID>/packages/maven deploy
             En GitLab CI la URL llega como $CI_API_V4_URL/projects/$CI_PROJECT_ID/packages/maven. -->
        <profile>
            <id>gitlab</id>
            <distributionManagement>
                <repository>
                    <id>gitlab</id>
                    <name>Smartbody - GitLab Package Registry</name>
                    <url>${gitlab.maven.url}</url>
                </repository>
                <snapshotRepository>
                    <id>gitlab</id>
                    <name>Smartbody - GitLab Package Registry (snapshots)</name>
                    <url>${gitlab.maven.url}</url>
                </snapshotRepository>
            </distributionManagement>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
