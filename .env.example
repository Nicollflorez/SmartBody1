# Copia este archivo como .env (ignorado por git) y cambia los valores antes de desplegar.

# Contrasena de root de MySQL (la usa tambien el backend).
MYSQL_ROOT_PASSWORD=cambiar-esta-contrasena

# Cuenta de administrador creada al primer arranque (minimo 10 caracteres). Dejar vacio para no crearla.
SMARTBODY_ADMIN_EMAIL=admin@smartbody.com
SMARTBODY_ADMIN_PASSWORD=

# Minutos de validez del JWT.
SMARTBODY_JWT_MINUTES=180

# Puerto publico de Nginx.
NGINX_PORT=80

# Monitoreo (Etapa 8): Prometheus en 9090 y Grafana en 3000.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=cambiar-esta-contrasena

# Imagen del backend (por defecto, la ultima publicada por el pipeline).
# BACKEND_IMAGE=registry.gitlab.com/nicollflorez/smartbody/backend:1.0.3
